# =====================================================================
# BPJS Autonomous Agent - Environment Variables Template
# =====================================================================

# IMPORTANT: Copy this to .env.local and fill in your values
# NEVER commit .env.local to version control!

# =====================================================================
# ENCRYPTION & SECURITY
# =====================================================================

# Master encryption key for credential vault
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED - Must be exactly 64 hex characters (32 bytes)
CREDENTIAL_MASTER_KEY=your-secure-master-key-64-hex-characters

# Node environment (development | production)
NODE_ENV=development

# Port for Express server
PORT=3000

# =====================================================================
# VAULT INTEGRATION (OPTIONAL - For Production)
# =====================================================================

# If using HashiCorp Vault
VAULT_ADDR=https://vault.yourdomain.com
VAULT_TOKEN=your-vault-token
VAULT_SECRET_PATH=secret/bpjs-credentials

# If using AWS Secrets Manager
AWS_REGION=ap-southeast-1
AWS_SECRET_NAME=bpjs-credentials

# =====================================================================
# LOGGING & MONITORING (OPTIONAL)
# =====================================================================

# Sentry DSN for error tracking
SENTRY_DSN=https://your-sentry-dsn

# Log level (debug | info | warn | error)
LOG_LEVEL=info

# =====================================================================
# BPJS PORTALS (OPTIONAL - For Testing)
# =====================================================================

# EDABU Portal (BPJS Kesehatan)
EDABU_URL=https://edabu.bpjskesehatan.go.id
EDABU_SANDBOX_URL=https://sandbox-edabu.bpjskesehatan.go.id

# SIPP Online (BPJS Ketenagakerjaan)
SIPP_URL=https://sipp.bpjsketenagakerjaan.go.id
SIPP_SANDBOX_URL=https://sandbox-sipp.bpjsketenagakerjaan.go.id

# =====================================================================
# SESSION CONFIGURATION (OPTIONAL - Can use defaults)
# =====================================================================

# Session duration in minutes (default: 60)
SESSION_DURATION_MINUTES=60

# Inactivity timeout in minutes (default: 30)
SESSION_INACTIVITY_MINUTES=30

# Token refresh threshold in minutes (default: 10)
SESSION_TOKEN_REFRESH_MINUTES=10

# Max concurrent sessions per portal (default: 3)
SESSION_MAX_CONCURRENT=3

# =====================================================================
# RETRY CONFIGURATION (OPTIONAL - Can use defaults)
# =====================================================================

# Max retry attempts (default: 3)
RETRY_MAX_ATTEMPTS=3

# Initial retry delay in milliseconds (default: 1000)
RETRY_INITIAL_DELAY_MS=1000

# =====================================================================
# API AUTHENTICATION (OPTIONAL - For Securing Endpoints)
# =====================================================================

# API Key for agent endpoints
API_KEY_BPJS_AGENT=your-secure-api-key

# JWT Secret (if using JWT authentication)
JWT_SECRET=your-jwt-secret

# =====================================================================
# DATABASE (OPTIONAL - For Persistence)
# =====================================================================

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/bpjs_db

# SQLite file path (if using SQLite)
SQLITE_DB_PATH=./data/bpjs.db

# =====================================================================
# ADDITIONAL CONFIGURATION
# =====================================================================

# Timezone (default: Asia/Jakarta)
TZ=Asia/Jakarta

# Application URL (for self-referential links)
APP_URL=http://localhost:3000

# Enable debug logging
DEBUG=false

# =====================================================================
# SECURITY NOTES
# =====================================================================

# ⚠️ NEVER:
# - Commit .env.local to version control
# - Share API keys or secrets
# - Use default values in production
# - Log sensitive credentials
# - Store passwords in plaintext

# ✅ DO:
# - Generate secure random keys (32+ characters)
# - Use different keys per environment
# - Rotate credentials regularly
# - Use vault for production secrets
# - Audit all credential access
# - Keep .env.local in .gitignore

# =====================================================================
